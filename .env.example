# Required. Exactly 6 digits. The server refuses to start without it.
ADMIN_PIN=123456
# Optional. Defaults shown.
PORT=8422
DATA_DIR=./data
# WellnessLiving OAuth2 client credentials and the HQ business id that location/list needs.
# Leave empty to run without roster sync.
WL_CLIENT_ID=
WL_CLIENT_SECRET=
WL_REGION=1
WL_BUSINESS=
# Optional. Exact rank category title (e.g. "Kids IBJJF Belts") that overrides the default
# kids-and-IBJJF category filter for the belts report. Leave empty to use the default.
WL_KIDS_CATEGORY=
# easton-leaderboard Supabase project (publishable key only). Leave empty to skip the ERP join.
LEADERBOARD_SUPABASE_URL=
LEADERBOARD_SUPABASE_KEY=
