# Required. Exactly 6 digits. The server refuses to start without it.
ADMIN_PIN=123456
# Optional. Defaults shown.
PORT=8422
DATA_DIR=./data
# Cloud only. Turso libsql database URL and auth token. Leave empty for LAN mode, which
# opens the DATA_DIR/DB_PATH file instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Cloud only. Public origin of the deployment (e.g. https://www.example.com), returned by
# /api/lan so the Connect page and QR codes point at it instead of a LAN address.
PUBLIC_URL=
# WellnessLiving OAuth2 client credentials and the HQ business id that location/list needs.
# Leave empty to run without roster sync.
WL_CLIENT_ID=
WL_CLIENT_SECRET=
WL_REGION=1
WL_BUSINESS=
# Optional. Exact rank category title (e.g. "Kids IBJJF Belts") that overrides the default
# kids-and-IBJJF category filter for the belts report. Leave empty to use the default.
WL_KIDS_CATEGORY=
# Cloud only. Optional. Caps roster-sync polling so it fits inside the function's time
# limit. Leave empty to use the default.
WL_SYNC_MAX_POLLS=
# easton-leaderboard Supabase project (publishable key only). Leave empty to skip the ERP join.
LEADERBOARD_SUPABASE_URL=
LEADERBOARD_SUPABASE_KEY=
